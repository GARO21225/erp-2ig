# HTTPS directement sur l'adresse IP et le port 8080 : https://204.168.229.74:8080
# Certificat émis par l'autorité interne de Caddy. Une autorité publique (Let's Encrypt) ne peut pas
# valider une IP sur un autre port que 80/443 : on installe donc UNE FOIS le certificat racine sur chaque
# appareil (téléchargeable sur /ca.crt) ; ensuite plus aucun avertissement.
{
	https_port 8080
	auto_https disable_redirects
	skip_install_trust
	default_sni {$DOMAIN}
}

https://{$DOMAIN}:8080 {
	tls internal
	encode gzip
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Disposition "attachment; filename=yakro-grill-ca.crt"
		file_server
	}
	handle /api/* {
		reverse_proxy erp-backend:4000
	}
	handle {
		reverse_proxy erp-frontend:80
	}
}
