# ── Base de données
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/erp_2ig?schema=public"

# ── Sécurité
JWT_SECRET="votre_jwt_secret_tres_long_et_securise_2ig_erp_minimum_32_chars"
NODE_ENV=production
PORT=4000
FRONTEND_URL="https://votre-frontend.pages.dev"

# ── GED (upload fichiers)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL=""

# ── Sauvegardes PostgreSQL
# Dossier local (Render : /tmp/erp-2ig-backups, VPS : /var/backups/erp-2ig)
BACKUP_DIR=/tmp/erp-2ig-backups

# Rétention
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# Stockage externe — Option 1 : AWS S3
# BACKUP_S3_BUCKET=erp-2ig-backups-bucket
# BACKUP_S3_REGION=eu-west-3
# BACKUP_S3_PREFIX=backups
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=votre_secret_key

# Stockage externe — Option 2 : FTP sécurisé
# BACKUP_FTP_HOST=ftp.votre-hebergeur.com
# BACKUP_FTP_USER=backup_user
# BACKUP_FTP_PASS=votre_mot_de_passe_ftp
# BACKUP_FTP_DIR=/backups/erp-2ig

# ── Logging
LOG_LEVEL=info
LOG_DIR=/tmp/erp-2ig-logs
