{
  "name": "erp-2ig-backend",
  "version": "1.0.0",
  "description": "ERP Groupe 2IG — Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:generate": "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 npx prisma generate",
    "db:migrate": "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 npx prisma migrate deploy",
    "db:push": "PRISMA_ENGINES_CHECKSUM_IGNORE_MISSING=1 npx prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "pg": "^8.11.0",
    "prisma": "^5.0.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}
